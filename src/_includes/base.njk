<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}{% if not isHome %} — {{ site.title }}{% endif %}</title>
{% if standfirst %}<meta name="description" content="{{ standfirst }}">{% endif %}
<link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
<link rel="icon" type="image/png" href="{{ '/assets/icons/favicon-32.png' | url }}">
<link rel="apple-touch-icon" href="{{ '/assets/icons/apple-touch-icon.png' | url }}">
<link rel="manifest" href="{{ '/manifest.webmanifest' | url }}">
<meta name="theme-color" content="#144210">
<meta name="apple-mobile-web-app-title" content="Cue Sports Rules">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
</head>
<body>
<div class="sheet">

  {% if not isHome %}
  <nav class="sitebar">
    <a href="{{ '/' | url }}">&larr; {{ site.title }}</a>
    <span>{{ site.tagline }}</span>
  </nav>
  {% endif %}

  {{ content | safe }}

</div>
</body>
</html>
